{
  "name": "rationales",
  "displayName": "rationales-visualization",
  "description": "An interactive data visualization tool that showcases code generation rationales from Large Language Models.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:rationale-panel",
    "onCommand:rationales-visualization.openRationaleWindow",
    "onView:rationale-panel",
    "onView:visualization-panel",
    "onCommand:rationale-panel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rationales-visualization.openRationaleWindow",
        "title": "Open Rationale Window"
      },
      {
        "command": "rationale-panel",
        "title": "Show Rationale and Visualization"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rationaleVisualizationContainer",
          "title": "Rationale and Visualization",
          "icon": "/media/placeholder.svg"
        }
      ]
    },
    "views": {
      "rationaleVisualizationContainer": [
        {
          "type": "webview",
          "id": "rationale-panel",
          "name": "Generated Rationale"
        },
        {
          "type": "webview",
          "id": "visualization-panel",
          "name": "Visualization"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "rationale-panel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.11",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "cacheable-request": "^12.0.1",
    "heap-js": "^2.5.0",
    "mermaid": "^11.4.0",
    "node-fetch": "^3.3.2",
    "pybridge": "^1.4.0"
  }
}
